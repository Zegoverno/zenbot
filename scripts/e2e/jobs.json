[
  {"when": "please schedule", "tool": "schedule", "args": {"action": "create", "name": "agent-made", "prompt": "JOBTASK-B", "schedule": "every 1h"}},
  {"when": "please schedule", "text": "Scheduled."},
  {"when": "JOBTASK-A", "tool": "schedule", "args": {"action": "list"}},
  {"when": "JOBTASK-A", "text": "Report A: all good."},
  {"when": "JOBTASK-S", "text": "[SILENT]"},
  {"when": "JOBTASK-F", "text": "[FAILED] the thing is broken"},
  {"when": "JOBTASK-R", "tool": "bash", "args": {"command": "mkdir -p out && printf 'REPORT FROM FILE: Palavra do Senhor.\\n' > out/message.md"}},
  {"when": "JOBTASK-R", "text": "Done: the answer, not the report."},
  {"when": "JOBTASK-N", "text": "Done, but no file written."},
  {"when": "JOBTASK-E", "tool": "bash", "args": {"command": "mkdir -p out && : > out/empty.md"}},
  {"when": "JOBTASK-E", "text": "Done."},
  {"when": "script please", "tool": "schedule", "args": {"action": "create", "name": "agent-script", "command": "echo AGENT SCRIPT RAN", "schedule": "every 1h"}},
  {"when": "script please", "tool": "schedule", "args": {"action": "resume", "name": "agent-script"}},
  {"when": "script please", "text": "Scheduled a script."},
  {"when": "change script", "tool": "schedule", "args": {"action": "update", "name": "agent-script", "command": "echo CHANGED"}},
  {"when": "change script", "text": "Changed."},
  {"when": "OWNER-HELLO", "text": "Hello, owner."}
]
