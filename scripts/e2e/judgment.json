    {"tool": "bash", "args": {"command": "grep -l ZEN_TOKEN /proc/[0-9]*/environ 2>/dev/null; echo procs-checked; (exec 3<>/dev/tcp/127.0.0.1/KERNELPORT) 2>/dev/null && echo reached-kernel || echo no-network; echo home-entries: $(ls -A ~ | wc -l)"}},
    {"tool": "read", "args": {"path": "~/.zenbot/AGENTS.md"}},
