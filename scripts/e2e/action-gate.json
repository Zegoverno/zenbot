[
  {"when":"GATE-VERIFY-GRANT","tool":"verify","args":{"goal":"exercise exact verification approval","criteria":[{"id":"writes","text":"append once","run":"git -c 'alias.zenprobe=!echo approved >> verify-grant.txt' zenprobe"}]}},
  {
    "when": "GATE-READ",
    "tool": "web_search",
    "args": {
      "query": "harbour"
    }
  },
  {
    "when": "GATE-READ",
    "tool": "bash",
    "args": {
      "command": "ls -la"
    }
  },
  {
    "when": "GATE-READ",
    "tool": "bash",
    "args": {
      "command": "git status --short"
    }
  },
  {
    "when": "GATE-READ",
    "tool": "write",
    "args": {
      "path": "notes.txt",
      "content": "safe workspace note\n"
    }
  },
  {
    "when": "GATE-SECRET",
    "tool": "bash",
    "args": {
      "command": "grep -ro . ZENHOME"
    }
  },
  {
    "when": "GATE-GREP",
    "tool": "bash",
    "args": {
      "command": "cd . && grep -n \"safe\\|zzz\" notes.txt | head -5"
    }
  },
  {
    "when": "GATE-GREP",
    "tool": "bash",
    "args": {
      "command": "echo $(id)"
    }
  },
  {
    "when": "GATE-GREP",
    "tool": "web_fetch",
    "args": {
      "url": "https://example.com/a"
    }
  },
  {
    "when": "GATE-GREP",
    "tool": "web_fetch",
    "args": {
      "url": "https://example.com/a?d=secret"
    }
  },
  {
    "when": "GATE-HOLD",
    "tool": "bash",
    "args": {
      "command": "curl -s -o /dev/null KERNELURL/health",
      "timeout_secs": 5
    }
  },
  {
    "when": "GATE-VERIFY",
    "tool": "verify",
    "args": {
      "goal": "attack",
      "dir": "OWNERHOME",
      "criteria": [
        {
          "text": "planted",
          "run": "python3 -c 'open(\".bashrc\",\"w\").write(\"planted\")'"
        }
      ]
    }
  },
  {
    "when": "GATE-PY",
    "tool": "bash",
    "args": {
      "command": "python3 -c 'import os; os.remove(\"notes.txt\")'"
    }
  },
  {
    "when": "GATE-JOB",
    "tool": "schedule",
    "args": {
      "action": "create",
      "name": "gate-job",
      "schedule": "every 1h",
      "prompt": "A test report."
    }
  },
  {
    "when": "GATE",
    "text": "Done."
  }
]
