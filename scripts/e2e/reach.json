[
  {
    "when": "mcp",
    "tool": "find_tools",
    "args": {
      "query": "echo a message and add numbers"
    }
  },
  {
    "when": "mcp",
    "tool": "load_tool",
    "args": {
      "name": "local_echo"
    }
  },
  {
    "when": "mcp",
    "tool": "call_tool",
    "args": {
      "name": "local_echo",
      "arguments": {
        "message": "hi"
      }
    }
  },
  {
    "when": "mcp",
    "tool": "call_tool",
    "args": {
      "name": "remote_add",
      "arguments": {
        "a": 2,
        "b": 3
      }
    }
  },
  {
    "when": "mcp",
    "tool": "call_tool",
    "args": {
      "name": "remote_add",
      "arguments": {
        "a": 2
      }
    }
  },
  {
    "when": "tool slow",
    "tool": "call_tool",
    "args": {
      "name": "local_slow",
      "arguments": {
        "seconds": 5
      }
    }
  },
  {
    "when": "tool quick",
    "tool": "call_tool",
    "args": {
      "name": "local_echo",
      "arguments": {
        "message": "quick"
      }
    }
  },
  {
    "when": "tool huge",
    "tool": "call_tool",
    "args": {
      "name": "local_huge",
      "arguments": {}
    }
  },
  {
    "when": "tool huge",
    "tool": "call_tool",
    "args": {
      "name": "remote_huge",
      "arguments": {}
    }
  },
  {
    "when": "tool find",
    "tool": "find_tools",
    "args": {
      "query": "echo"
    }
  },
  {
    "when": "web",
    "tool": "web_search",
    "args": {
      "query": "zenbot agent"
    }
  },
  {
    "when": "web",
    "tool": "remember",
    "args": {
      "text": "Something read on the web.",
      "source": "owner"
    }
  },
  {
    "text": "Done."
  }
]
