[Unit]
Description=zenbot: update the model engines (Claude Code, Codex, Pi) to their latest versions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=PATH=__HOME__/.local/bin:__HOME__/.local/node/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__REPO__/scripts/update-engines.sh
TimeoutStartSec=1h
