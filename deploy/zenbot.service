[Unit]
Description=zenbot kernel (zend, with its workers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=__HOME__/.zenbot/env
ExecStart=__HOME__/.zenbot/bin/zend
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
