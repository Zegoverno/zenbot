[Unit]
Description=zenbot kernel (zend + zen-mind)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=__HOME__/.zenbot/env
# "+" runs as root so the user doesn't need to be in the docker group.
ExecStartPre=+/usr/bin/docker compose -f __REPO__/deploy/compose.yaml up -d --wait postgres
ExecStart=__HOME__/.zenbot/bin/zend
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
